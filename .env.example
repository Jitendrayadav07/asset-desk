PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:your-password@aws-0-region.pooler.supabase.com:5432/postgres

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory (tenant) ID from Azure App Overview. Use "common" for multi-tenant apps.
MICROSOFT_TENANT_ID=
# Base URL of THIS backend (used to build the callback URL and success redirect)
REDIRECT_URL=http://localhost:4000
# Frontend origin for CORS (optional; defaults to "*" reflected with credentials)
CLIENT_ORIGIN=http://localhost:5173
# Express-session secret (any long random string)
SESSION_SECRET=replace-with-a-long-random-string
